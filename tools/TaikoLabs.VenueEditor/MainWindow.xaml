<Window x:Class="TaikoLabs.VenueEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="매장 등록기 — 태고 멀티뷰"
        Height="880" Width="1180"
        MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F6F5F3">

    <DockPanel>

        <!-- File bar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="SaveButton" Click="OnSaveClick" Margin="8,0,0,0">저장</Button>
                <Button DockPanel.Dock="Right" Click="OnBrowseClick">파일 선택…</Button>
                <TextBlock DockPanel.Dock="Left" Text="설정 파일" VerticalAlignment="Center"
                           Margin="0,0,10,0" Foreground="#666" />
                <TextBox x:Name="PathBox" Margin="0" IsReadOnly="True" Background="#FAFAFA" />
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#DDD" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock x:Name="StatusText" Foreground="#666" TextTrimming="CharacterEllipsis" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Venue list -->
            <DockPanel Grid.Column="0" Background="White" Margin="0,0,1,0">
                <TextBlock DockPanel.Dock="Top" Text="매장" FontWeight="SemiBold" Margin="12,12,12,8" />

                <Border DockPanel.Dock="Bottom" Padding="8" BorderBrush="#EEE" BorderThickness="0,1,0,0">
                    <UniformGrid Columns="3">
                        <Button Click="OnAddVenueClick" MinWidth="0" Margin="2">추가</Button>
                        <Button Click="OnDuplicateVenueClick" MinWidth="0" Margin="2">복제</Button>
                        <Button Click="OnRemoveVenueClick" MinWidth="0" Margin="2">삭제</Button>
                    </UniformGrid>
                </Border>

                <ListBox x:Name="VenueList" BorderThickness="0" Margin="4"
                         SelectionChanged="OnVenueSelectionChanged"
                         DisplayMemberPath="Display" />
            </DockPanel>

            <!-- Editor -->
            <TabControl Grid.Column="1" x:Name="EditorTabs" Margin="12" Padding="0">

                <TabItem Header="기본">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" Text="id — URL과 설정에서 이 매장을 가리키는 값 (영소문자·숫자·하이픈)" />
                            <TextBox x:Name="IdBox" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="name — 탭에 표시할 매장 이름" />
                            <TextBox x:Name="NameBox" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="accent — 탭 강조색 (#RRGGBB)" />
                            <DockPanel Margin="0,0,0,10">
                                <Border DockPanel.Dock="Right" x:Name="AccentSwatch" Width="34" Margin="8,0,0,0"
                                        BorderBrush="#CCC" BorderThickness="1" CornerRadius="3" />
                                <TextBox x:Name="AccentBox" Margin="0" />
                            </DockPanel>

                            <Separator Margin="0,8,0,14" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="채널 — @핸들, 채널 URL, 또는 UC로 시작하는 id를 붙여넣고 [조회]" />
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" x:Name="ResolveButton" Click="OnResolveChannelClick"
                                        Margin="8,0,0,0">조회</Button>
                                <TextBox x:Name="ChannelInputBox" Margin="0" />
                            </DockPanel>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="channelId" />
                            <TextBox x:Name="ChannelIdBox" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="channelUrl — 매장 채널 링크 (선택)" />
                            <TextBox x:Name="ChannelUrlBox" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="naverPlaceId — 임시휴무 자동 감지에 사용 (선택). 네이버 지도 URL의 place/뒤 숫자" />
                            <TextBox x:Name="NaverBox" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="제목 규칙">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="titlePattern — 방송 제목에서 기체명을 뽑는 정규식. (?&lt;name&gt;...) 그룹이 반드시 필요합니다." />
                            <TextBox x:Name="PatternBox" FontFamily="Consolas" TextWrapping="Wrap"
                                     AcceptsReturn="False" TextChanged="OnPatternChanged" />
                            <TextBlock x:Name="PatternError" Foreground="#C0392B" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,0,0,10" />
                        </StackPanel>

                        <Border Grid.Row="1" Background="#FFF8E6" BorderBrush="#F0DFAE" BorderThickness="1"
                                CornerRadius="4" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="패턴 만들기" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                           Text="아래 목록에서 제목을 하나 고른 뒤, 이 칸에서 기체명에 해당하는 부분만 드래그로 선택하고 [선택 부분이 기체명]을 누르세요. 날짜·회차 숫자는 자동으로 일반화됩니다." />
                                <TextBox x:Name="SampleBox" FontFamily="Consolas" Margin="0,4,0,8" />
                                <Button Click="OnBuildPatternClick" HorizontalAlignment="Left">선택 부분이 기체명</Button>
                            </StackPanel>
                        </Border>

                        <DockPanel Grid.Row="2">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" x:Name="FetchButton" Click="OnFetchTitlesClick"
                                        Margin="8,0,0,0">채널에서 제목 가져오기</Button>
                                <TextBlock Text="최근 방송 제목으로 패턴과 기체 매칭을 함께 검증합니다."
                                           VerticalAlignment="Center" Foreground="#666" FontSize="12" />
                            </DockPanel>

                            <DataGrid x:Name="TitleGrid" IsReadOnly="True" CanUserAddRows="False"
                                      SelectionChanged="OnTitleSelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="제목" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="기체명" Binding="{Binding Name}" Width="110" />
                                    <DataGridTextColumn Header="매칭된 기체" Binding="{Binding Station}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="기체 · 구역">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="2*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Style="{StaticResource FieldLabel}"
                                       Text="기체 — id는 내부 식별자, label은 화면에 표시되는 이름. aliases는 제목에 쓰이는 다른 표기를 쉼표로 구분해 적습니다." />
                            <DataGrid x:Name="StationGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    <DataGridTextColumn Header="label" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                    <DataGridTextColumn Header="zoneId" Binding="{Binding ZoneId, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                    <DataGridTextColumn Header="aliases (쉼표 구분)" Binding="{Binding Aliases, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>

                        <Separator Grid.Row="1" Margin="0,14" />

                        <DockPanel Grid.Row="2">
                            <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
                                       Style="{StaticResource FieldLabel}"
                                       Text="구역 — 2개 이상일 때만 보기 목록에 구역별 항목이 생깁니다. 나눌 필요가 없으면 비워 두세요." />
                            <DataGrid x:Name="ZoneGrid">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="id" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                    <DataGridTextColumn Header="code (배치도 표기)" Binding="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Width="160" />
                                    <DataGridTextColumn Header="label (보기 이름)" Binding="{Binding Label, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="영업시간">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                       Text="자정을 넘기는 마감은 시를 24 이상으로 적습니다. 예: 07:00~익일 05:00 → 마감 29:00" />

                            <DataGrid x:Name="HourGrid" CanUserAddRows="False" Margin="0,8,0,16">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="요일" Binding="{Binding DayLabel}" IsReadOnly="True" Width="60" />
                                    <DataGridTextColumn Header="오픈" Binding="{Binding Open, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    <DataGridTextColumn Header="마감" Binding="{Binding Close, UpdateSourceTrigger=PropertyChanged}" Width="100" />
                                    <DataGridCheckBoxColumn Header="휴무" Binding="{Binding IsClosed, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <TextBlock Style="{StaticResource FieldLabel}"
                                       Text="확정된 휴무일 — 한 줄에 하나씩 yyyy-MM-dd" />
                            <TextBox x:Name="ClosedDatesBox" AcceptsReturn="True" Height="110"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
                            <TextBlock Style="{StaticResource FieldLabel}" TextWrapping="Wrap"
                                       Text="naverPlaceId를 넣어두면 임시휴무는 하루 한 번 자동으로 반영됩니다. 여기에 적은 날짜가 항상 우선합니다." />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="배치도">
                    <StackPanel Margin="16">
                        <TextBlock x:Name="LayoutSummaryText" TextWrapping="Wrap" Margin="0,0,0,12" />
                        <TextBlock TextWrapping="Wrap" Foreground="#666" FontSize="12">
                            이 등록기는 배치도 좌표를 편집하지 않습니다. 기존 매장의 좌표는 저장할 때 그대로 보존되고,
                            새로 추가한 매장은 배치도 없이 그리드 보기만 제공합니다.
                            배치도를 넣으려면 appsettings.json 의 layout 항목을 직접 작성하세요.
                        </TextBlock>
                        <Button Click="OnClearLayoutClick" HorizontalAlignment="Left" Margin="0,16,0,0">
                            이 매장의 배치도 제거
                        </Button>
                    </StackPanel>
                </TabItem>

                <TabItem Header="검증">
                    <DockPanel Margin="16">
                        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Click="OnValidateClick"
                                Margin="0,0,0,12">다시 검사</Button>
                        <ListBox x:Name="IssueList" BorderBrush="#DDD">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="2,3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

            </TabControl>
        </Grid>
    </DockPanel>
</Window>
