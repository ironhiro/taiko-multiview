<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Not invariant: resolving IANA zone ids such as Asia/Seoul needs the ICU data. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>TaikoLabs.Api</RootNamespace>
    <UserSecretsId>b1b1b905-cbaa-47b7-b84b-a62ab0c58a51</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The venue list; shipped beside appsettings.json in every build and publish. -->
    <Content Update="venues.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The /status page. Kept out of wwwroot, which holds the frontend build in the container
         and is served to everyone: this page is only mapped while ApiDocs is on. -->
    <Content Include="Status/status.html" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests reach the few internals they check directly. -->
    <InternalsVisibleTo Include="TaikoLabs.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

</Project>
