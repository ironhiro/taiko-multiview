{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173",
      "http://taiko.multiview"
    ]
  },
  "YouTube": {
    "ApiKey": "",
    "Mode": "Auto",
    "PollIntervalSeconds": 60,
    "ClosedPollIntervalSeconds": 600,
    "PreOpenMinutes": 30,
    "ManualRefreshCooldownSeconds": 60,
    "MaxVideoIdsPerLookup": 50
  },
  "Venues": {
    "TimeZone": "Asia/Seoul",
    "ClosureRefreshHour": 5,
    "ClosureCachePath": "closures.cache.json"
  }
}
