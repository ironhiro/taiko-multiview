{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    },
    "Console": {
      "FormatterName": "simple"
    }
  },
  "Cors": {
    "AllowedOrigins": [ "*" ]
  },
  "Diagnostics": {
    "ClientReports": true,
    "PerClientPerMinute": 120,
    "InfoSampleRate": 1
  },
  "YouTube": {
    "Mode": "Auto",
    "PollIntervalSeconds": 120
  }
}
