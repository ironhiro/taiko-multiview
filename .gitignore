# Vercel
.vercel

# Secrets - never commit the YouTube API key.
# Match the key file exactly: a wildcard like *API* also hides every Api-named
# source file, because git ignores case on Windows.
appsettings.Local.json
*.local
APIKey.txt
apikey.txt
*.key

# Runtime cache, regenerated on startup
closures.cache.json


# Local design-tool notes (Hallmark)
.hallmark/

# Soak-test output
logs/

# Generated mock venues for load tests (scripts/mock-venues.mjs)
venues.mock.json

# Performance run results (frontend/perf)
frontend/perf/results/

# Harness intermediate artifacts (multiview-harness)
_workspace/
_workspace_*/
_review/
_review_*/
