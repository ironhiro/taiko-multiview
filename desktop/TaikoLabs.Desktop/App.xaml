<Application x:Class="TaikoLabs.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <SolidColorBrush x:Key="ShellBackground" Color="#0F0D0B" />
        <SolidColorBrush x:Key="ShellPanel" Color="#191512" />
        <SolidColorBrush x:Key="ShellBorder" Color="#4A3D32" />
        <SolidColorBrush x:Key="ShellText" Color="#F0EBE3" />
        <SolidColorBrush x:Key="ShellTextDim" Color="#9B9088" />
        <SolidColorBrush x:Key="ShellAccent" Color="#E8B24A" />

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="#221C17" />
            <Setter Property="Foreground" Value="{StaticResource ShellText}" />
            <Setter Property="BorderBrush" Value="{StaticResource ShellBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource ShellAccent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
